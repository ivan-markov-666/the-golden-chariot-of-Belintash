{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"],
      "@/navigation/*": ["src/navigation/*"],
      "@/screens/*": ["src/screens/*"],
      "@/components/*": ["src/components/*"],
      "@/state/*": ["src/state/*"],
      "@/services/*": ["src/services/*"]
    }
  },
  "include": ["src", "App.tsx", "jest.setup.js"]
}
