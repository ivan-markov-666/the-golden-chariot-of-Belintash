{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "src/*": ["src/*"],
      "@/navigation/*": ["src/navigation/*"],
      "@/screens/*": ["src/screens/*"],
      "@/components/*": ["src/components/*"],
      "@/state/*": ["src/state/*"],
      "@/services/*": ["src/services/*"],
      "@/game/*": ["src/game/*"],
      "@/store/*": ["src/store/*"],
      "@/theme/*": ["src/theme/*"]
    }
  },
  "include": ["src", "App.tsx", "jest.setup.js"]
}
